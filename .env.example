PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/portfolio
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-secure-password
NOTIFICATION_EMAIL=notification@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email
SMTP_PASS=your_smtp_password
SMTP_FROM="Portfolio <your_email>"
VAPID_SUBJECT=mailto:your_email@gmail.com
VAPID_PUBLIC_KEY=generate_once_and_keep
VAPID_PRIVATE_KEY=generate_once_and_keep_secret
NODE_ENV=development
